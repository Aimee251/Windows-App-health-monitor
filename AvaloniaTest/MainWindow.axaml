<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:AppHealth.Core;assembly=AvaloniaTest"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        x:Class="AvaloniaTest.MainWindow"
        Width="1000" Height="720"
        Title="App Health Monitor">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Process Triage (worst first)"
                       FontSize="18" FontWeight="Bold"/>
            <TextBlock Name="StatusText" Text="starting…"
                       FontSize="12" Foreground="Gray" Margin="0,4,0,0"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Height="140" Margin="0,0,0,8"
                BorderBrush="LightGray" BorderThickness="1" Padding="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Operation Latency (worst tail first)"
                           FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                <DataGrid Name="LatencyGrid" IsReadOnly="True" GridLinesVisibility="Horizontal"
                          x:DataType="core:OpConcern">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="App"       Binding="{Binding AppName}" Width="150"/>
                        <DataGridTextColumn Header="Severity"  Binding="{Binding Severity}" Width="80"/>
                        <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="140"/>
                        <DataGridTextColumn Header="p50" Binding="{Binding P50, StringFormat='{}{0:0}ms'}" Width="70"/>
                        <DataGridTextColumn Header="p95" Binding="{Binding P95, StringFormat='{}{0:0}ms'}" Width="70"/>
                        <DataGridTextColumn Header="p99" Binding="{Binding P99, StringFormat='{}{0:0}ms'}" Width="70"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Height="300" Margin="0,8,0,0"
                BorderBrush="LightGray" BorderThickness="1" Padding="8">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Name="DetailTitle" Text="Detail" FontWeight="Bold" FontSize="14"
                               VerticalAlignment="Center"/>
                    <Button Name="BackButton" Content="◀ Back to worst"
                            HorizontalAlignment="Right" Click="OnBackToWorst"/>
                </Grid>
                <TextBlock Name="DetailStats" DockPanel.Dock="Top" Text=""
                           FontSize="12" Foreground="DimGray" Margin="0,0,0,6"/>
                <Grid ColumnDefinitions="*,*">
                    <sp:AvaPlot Name="MemoryChart" Grid.Column="0" Margin="0,0,4,0"/>
                    <sp:AvaPlot Name="CpuChart"    Grid.Column="1" Margin="4,0,0,0"/>
                </Grid>
            </DockPanel>
        </Border>

        <DataGrid Name="TriageGrid" IsReadOnly="True" GridLinesVisibility="Horizontal"
                  x:DataType="core:Concern" SelectionChanged="OnRowSelected">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                <DataGridTextColumn Header="Process"  Binding="{Binding ProcessName}" Width="200"/>
                <DataGridTextColumn Header="Score"    Binding="{Binding Score}" Width="70"/>
                <DataGridTextColumn Header="Reason"   Binding="{Binding Reason}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>